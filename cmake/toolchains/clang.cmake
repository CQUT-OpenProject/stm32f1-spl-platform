include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
find_program(STM32F1_CLANG NAMES clang REQUIRED)
get_filename_component(_clang_bin "${STM32F1_CLANG}" DIRECTORY)
find_program(STM32F1_LLD NAMES ld.lld HINTS "${_clang_bin}" REQUIRED)
if(NOT EXISTS "${STM32F1_CLANG}" OR NOT EXISTS "${STM32F1_LLD}")
    message(FATAL_ERROR "STM32F1_CLANG and STM32F1_LLD must point to existing executables")
endif()
set(CMAKE_C_COMPILER "${STM32F1_CLANG}")
set(CMAKE_ASM_COMPILER "${STM32F1_CLANG}")
set(CMAKE_C_COMPILER_TARGET arm-none-eabi)
set(CMAKE_ASM_COMPILER_TARGET arm-none-eabi)
string(APPEND CMAKE_ASM_FLAGS_INIT " --target=arm-none-eabi")
